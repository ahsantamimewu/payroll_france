  },
  {
    "id": "rule-btp-dirtyworkpremium-v1",
    "description": "Premium for unusually dirty work (prime de salissure).",
    "condition": "input.dirty_work_days > 0",
    "action": {
      "type": "add_fixed_allowance",
      "parameters": {
        "amount_per_day": 5.00,
        "units": "input.dirty_work_days",
        "allowance_name": "Prime pour travaux insalubres ou salissants"
      }
